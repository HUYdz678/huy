                <img src="Screenshot 2026-05-10 090754.png">
            </div>

            <div class="chitiet">
                <div class="ten">Classico 03</div>

                <div>
                    <span class="gia-cu">7000 đ</span>
                    <span class="gia-moi">5000 đ</span>
                </div>

                <button class="nut">THÊM VÀO GIỎ</button>
            </div>

            <div class="giamgia">-29%</div>
        </div>

        <!-- SẢN PHẨM 4 -->
